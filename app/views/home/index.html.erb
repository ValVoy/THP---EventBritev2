<%# HERO SECTION %>
<div class="text-white text-center py-5" style="background: linear-gradient(135deg, #1a1f35 0%, #2d1b69 50%, #1a1f35 100%); border-radius: 1rem; margin: 1.5rem;">
  <div class="py-4">
    <h1 class="display-4 fw-bold mb-3">Découvrez. Participez. Créez.</h1>
    <p class="fs-5 text-secondary mb-4">La plateforme communautaire pour vivre des moments inoubliables.</p>
    <% if user_signed_in? %>
      <%= link_to "Proposer un événement", new_event_path, class: "btn btn-outline-light rounded-pill px-5 fw-bold" %>
    <% else %>
      <%= link_to "Rejoindre la communauté", new_user_registration_path, class: "btn btn-outline-light rounded-pill px-5 fw-bold" %>
    <% end %>
  </div>
</div>

<%# ÉVÉNEMENTS À VENIR %>
<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold text-white border-start border-primary ps-3">Prochains événements</h2>
    <span class="text-secondary small"><%= Event.count %> événements disponibles</span>
  </div>

  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <% @upcoming_events.each do |event| %>
      <%= render 'events/event_card', event: event %>
    <% end %>
  </div>

  <div class="text-center mt-5">
    <%= link_to "Voir tous les événements →", events_path, class: "btn btn-primary rounded-pill px-5 fw-bold" %>
  </div>
</div>