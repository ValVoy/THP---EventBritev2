<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-5">
      <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="background: #161b22; border: 1px solid #30363d !important;">
        
        <div class="p-4 border-bottom border-secondary bg-dark text-center">
          <h2 class="text-white fw-bold mb-0">Créer un compte</h2>
          <p class="text-secondary small mb-0">Rejoignez la communauté Eventbrite-Like</p>
        </div>

        <div class="card-body p-4 text-white">
          <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
            <%= render "devise/shared/error_messages", resource: resource %>

            <div class="mb-3">
              <%= f.label :email, class: "form-label text-secondary small fw-bold" %>
              <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control bg-dark text-white border-secondary rounded-pill px-3 py-2", placeholder: "nom@exemple.com" %>
            </div>

            <div class="mb-3">
              <%= f.label :password, "Mot de passe", class: "form-label text-secondary small fw-bold" %>
              <% if @minimum_password_length %>
                <span class="text-muted small">(<%= @minimum_password_length %> caractères min.)</span>
              <% end %>
              <%= f.password_field :password, autocomplete: "new-password", class: "form-control bg-dark text-white border-secondary rounded-pill px-3 py-2" %>
            </div>

            <div class="mb-4">
              <%= f.label :password_confirmation, "Confirmer le mot de passe", class: "form-label text-secondary small fw-bold" %>
              <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control bg-dark text-white border-secondary rounded-pill px-3 py-2" %>
            </div>

            <div class="d-grid">
              <%= f.submit "S'inscrire", class: "btn btn-primary rounded-pill fw-bold py-2 shadow-sm" %>
            </div>
          <% end %>

          <hr class="my-4 border-secondary opacity-25">

          <div class="text-center">
            <p class="text-secondary small mb-0">Déjà un compte ?</p>
            <%= render "devise/shared/links" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>