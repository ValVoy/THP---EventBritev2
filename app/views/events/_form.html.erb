<%= form_with(model: event, local: true, class: "text-white") do |f| %>
  <div class="mb-3">
    <%= f.label :title, "Titre de l'événement", class: "form-label text-secondary" %>
    <%= f.text_field :title, class: "form-control bg-dark text-white border-secondary", placeholder: "Ex: Super Soirée Code" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :start_date, "Date de début", class: "form-label text-secondary" %>
      <%= f.datetime_local_field :start_date, class: "form-control bg-dark text-white border-secondary" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :duration, "Durée (min)", class: "form-label text-secondary" %>
      <%= f.number_field :duration, step: 5, class: "form-control bg-dark text-white border-secondary" %>
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :description, "Description", class: "form-label text-secondary" %>
    <%= f.text_area :description, rows: 5, class: "form-control bg-dark text-white border-secondary" %>
  </div>

  <div class="row">
    <div class="col-md-6 mb-3">
      <%= f.label :price, "Prix (€)", class: "form-label text-secondary" %>
      <%= f.number_field :price, class: "form-control bg-dark text-white border-secondary" %>
    </div>
    <div class="col-md-6 mb-3">
      <%= f.label :location, "Lieu", class: "form-label text-secondary" %>
      <%= f.text_field :location, class: "form-control bg-dark text-white border-secondary" %>
    </div>
  </div>

  <div class="mt-4">
    <%= f.submit "Enregistrer les modifications", class: "btn btn-warning w-100 rounded-pill fw-bold py-3" %>
  </div>
<% end %>