<div class="col">
  <div class="card h-100 border-0 rounded-4 shadow-sm transition-hover" style="background: #161b22; border: 1px solid #30363d !important;">
    <div class="card-body p-4 d-flex flex-column">
      
      <div class="mb-3">
        <div class="d-flex align-items-center gap-2 mb-1">
          <h4 class="card-title fw-bold text-white m-0 text-truncate"><%= event.title %></h4>
          <% if event.attendances.count >= 5 %>
            <span class="text-warning small">🔥</span>
          <% end %>
        </div>
        <p class="text-secondary small m-0">
          📍 <%= event.location %> • 📅 <%= event.start_date.strftime("%d/%m") %>
        </p>
      </div>

      <p class="card-text text-secondary mb-4 small opacity-75" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.5;">
        <%= event.description %>
      </p>

      <div class="mt-auto pt-3 border-top border-secondary d-flex align-items-center justify-content-between">
        <span class="fw-bold fs-5 text-white"><%= event.price == 0 ? "Gratuit" : "#{event.price}€" %></span>
        
        <% if user_signed_in? && event.admin == current_user %>
          <%= link_to "Gérer", event_path(event), class: "btn btn-warning rounded-pill px-4 fw-bold btn-sm" %>
        <% else %>
          <%= link_to "Réserver", event_path(event), class: "btn btn-outline-primary rounded-pill px-4 fw-bold btn-sm" %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style>
  .transition-hover:hover {
    transform: translateY(-4px);
    border-color: #58a6ff !important;
    transition: all 0.2s ease-in-out;
  }
</style>