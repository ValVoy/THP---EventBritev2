<div class="container mt-5 mb-5">
  <%= render 'hero_section' %>
  <div id="events-grid" class="mb-5">
    <div class="card p-4 border-0 rounded-4 shadow-sm mb-4" style="background: #161b22; border: 1px solid #30363d !important;">
      <%= form_with url: events_path, method: :get, class: "row g-3 align-items-end" do |f| %>

        <div class="col-md-3">
          <label class="form-label text-secondary small">Ville</label>
          <%= f.select :city, Event.distinct.pluck(:location), { include_blank: "Toutes les villes", selected: params[:city] }, { class: "form-select bg-dark text-white border-secondary rounded-pill" } %>
        </div>

        <div class="col-md-4">
          <label class="form-label text-secondary small">Prix max : <span id="priceValue" class="text-success fw-bold"><%= params[:max_price] || 100 %></span> €</label>
          <%= f.range_field :max_price, in: 0..100, step: 5, value: params[:max_price] || 100, class: "form-range", id: "priceRange", oninput: "document.getElementById('priceValue').innerText = this.value" %>
          <%= f.hidden_field :min_price, value: 0 %>
        </div>

        <div class="col-md-3">
          <label class="form-label text-secondary small">Trier par</label>
          <%= f.select :sort, [["Plus récent", "newest"], ["Moins cher", "price_asc"], ["Plus proche", "date_asc"]], { selected: params[:sort] }, { class: "form-select bg-dark text-white border-secondary rounded-pill" } %>
        </div>

        <div class="col-md-2 d-grid">
          <%= f.submit "Explorer", class: "btn btn-primary rounded-pill fw-bold" %>
        </div>
      <% end %>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% @events.each do |event| %>
        <%= render 'event_card', event: event %>
      <% end %>
    </div>

    <div class="d-flex justify-content-center mt-5">
      <%== @pagy.series_nav %>
    </div>
  </div>
</div>