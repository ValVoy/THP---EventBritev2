<!DOCTYPE html>
<html data-bs-theme="dark" class="h-100">
  <head>
    <title>EventbriteVal</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    
    <%# --- CONFIGURATION PWA --- %>
    <link rel="manifest" href="/manifest.json">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# ----------------------------------- %>

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <%# Bootstrap 5.3 CDN %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <%# JS Bootstrap avec reload pour fixer les comportements Turbo %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" data-turbo-track="reload" defer></script>
    
    <%= yield :head %>
  </head>

  <body style="background-color: #0d1117; margin: 0; padding: 0; min-height: 100vh; display: flex; flex-direction: column;">
    
    <%# Navbar globale %>
    <%= render "layouts/navbar" %>
    
    <%# Conteneur des messages flash Devise/Rails %>
    <div class="container mt-3">
      <% flash.each do |key, message| %>
        <div class="alert alert-<%= key == 'notice' ? 'success' : 'danger' %> alert-dismissible fade show border-0 shadow-sm" 
             role="alert" 
             style="background-color: <%= key == 'notice' ? 'rgba(25, 135, 84, 0.2)' : 'rgba(220, 53, 69, 0.2)' %>; color: white;">
          <%= message %>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      <% end %>
    </div>

    <main class="flex-shrink-0">
      <%= yield %>
    </main>

    <%# Optionnel : Un petit footer pour finir le design %>
    <footer class="footer mt-auto py-4 border-top border-secondary" style="background-color: #0d1117; border-color: #30363d !important;">
      <div class="container text-center">
        <span class="text-secondary small">© 2026 Eventbrite-Like - Projet THP</span>
      </div>
    </footer>

  </body>
</html>